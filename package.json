{
  "name": "railway-todo-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Minimal TODO app: Vite + Hono + Postgres + Google SSO, deployed on Railway",
  "license": "MIT",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @repo/server dev\" \"pnpm --filter @repo/web dev\"",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/index.js",
    "db:migrate": "pnpm --filter @repo/server db:migrate",
    "db:generate": "pnpm --filter @repo/server db:generate",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json && tsc -p .railway/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "railway": "^3.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
